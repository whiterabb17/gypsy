# Gypsy Agent Configuration

# --- LLM & Provider ---
# Options: ollama, openai, anthropic, gemini
PROVIDER=ollama
#MODEL_NAME=llama3
MODEL_NAME=qwen2.5-coder:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_DIMENSION=768

# API Keys (Enable if not using Ollama)
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# --- Memory Tuning (MindPalace) ---
# 0 = AUTO (scale based on model context window)
MODEL_CONTEXT_WINDOW=32768
SIMILARITY_THRESHOLD=0.85
COMPRESSION_RATIO=0.6
MAX_CONTEXT_ITEMS=100
BASE_TTL_SECONDS=3600
SUMMARY_INTERVAL=15
MAX_TOKENS_PER_DREAM=50000

# --- Resilience ---
FAILURE_THRESHOLD=3
RETRY_TIMEOUT_SECONDS=30

# --- Sandbox & Tool Execution ---
# Options: local, docker, wasm
SANDBOX_MODE=wasm
DOCKER_IMAGE=alpine:latest
RAM_LIMIT_MB=1024
CPU_LIMIT_PERCENT=50
# WASM_MODULE_PATH=./tools/my_tool.wasm

# --- Storage & Session ---
# In debug mode, this defaults to ./memory automatically
STORAGE_PATH=.agent/storage

# --- MCP & Plugins ---
# Register servers with "MCP_SERVER_" prefix. Format: NAME=command
# The standard filesystem server is now builtin. Use MCP_FS_PATHS to allow extra paths.
# MCP_SERVER_REPORANGER=npx -y @modelcontextprotocol/server-repository-ranger
# FIRECRAWL_API_KEY=fc-42c525d2cf424125829930e8a7c0d640
MCP_SERVER_DUCKDUCKGO="npx -y duckduckgo-mcp-server"

# --- Local Skills ---
# Path to the directory containing agentskills.io-compatible skill folders
SKILLS_PATH=.agent/skills

# --- Personality & Reliability ---
GYPSY_PERSONALITY="You are Gypsy, a reliable and honest AI assistant. If a tool call returns an error or no data, do NOT hallucinate result contents. Instead, explain that you cannot access the requested information and suggest an alternative or ask for clarification. Accuracy is more important than being helpful with invented data."
GYPSY_SYSTEM_PROMPT="Your sandbox root is the current working directory. You cannot access paths outside this directory unless explicitly allowed via MCP configuration. Always verify file existence before reporting contents."
